generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORGANIZADOR
  COMPETIDOR
  ARBITRO
}

enum AuditAction {
  LOGIN
  CREATE_TOURNAMENT
  UPDATE_TOURNAMENT
  DELETE_TOURNAMENT
  REGISTER_COMPETITOR
  REPORT_MATCH_RESULT
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String
  role               Role
  firstName          String?
  lastName           String?
  cityId             String?
  countryId          String?
  createdAt          DateTime           @default(now())
  tournaments        Tournament[]       @relation("OrganizerTournaments")
  registrations      Registration[]
  arbitratedMatches  Match[]            @relation("AssignedReferee")
  auditLogs          AuditLog[]
  competitorProfile  CompetitorProfile?
  city               City?              @relation(fields: [cityId], references: [id])
  country            Country?           @relation(fields: [countryId], references: [id])
}

model Tournament {
  id                   String               @id @default(cuid())
  name                 String
  organizerId          String
  organizer            User                 @relation("OrganizerTournaments", fields: [organizerId], references: [id])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  matches              Match[]
  registrations        Registration[]
  tournamentCategories TournamentCategory[]
}

model Registration {
  id           String     @id @default(cuid())
  competitorId String
  tournamentId String
  createdAt    DateTime   @default(now())
  competitor   User       @relation(fields: [competitorId], references: [id])
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  @@unique([competitorId, tournamentId])
}

model Match {
  id            String     @id @default(cuid())
  tournamentId  String
  refereeId     String
  result        String?
  playedAt      DateTime?
  tournament    Tournament @relation(fields: [tournamentId], references: [id])
  referee       User       @relation("AssignedReferee", fields: [refereeId], references: [id])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  action    AuditAction
  targetId  String?
  detail    String?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])
}

model City {
  id         String              @id @default(cuid())
  name       String
  countryId  String
  createdAt  DateTime            @default(now())
  country    Country             @relation(fields: [countryId], references: [id])
  profiles   CompetitorProfile[]
  users      User[]

  @@unique([countryId, name])
}

model Country {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  cities    City[]
  users     User[]
}

model Sport {
  id                  String                @id @default(cuid())
  name                String                @unique
  createdAt           DateTime              @default(now())
  categories          SportCategory[]
  profiles            CompetitorProfile[]
  tournamentCategories TournamentCategory[]
}

model SportCategory {
  id         String              @id @default(cuid())
  name       String
  sportId    String
  createdAt  DateTime            @default(now())
  sport      Sport               @relation(fields: [sportId], references: [id])
  profiles   CompetitorProfile[]
  tournamentCategories TournamentCategory[]

  @@unique([sportId, name])
}

model TournamentCategory {
  id              String        @id @default(cuid())
  tournamentId    String
  sportId         String
  sportCategoryId String
  createdAt       DateTime      @default(now())
  tournament      Tournament    @relation(fields: [tournamentId], references: [id])
  sport           Sport         @relation(fields: [sportId], references: [id])
  sportCategory   SportCategory @relation(fields: [sportCategoryId], references: [id])

  @@unique([tournamentId, sportCategoryId])
}

model CompetitorProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  cityId          String
  sportId         String?
  sportCategoryId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  city            City          @relation(fields: [cityId], references: [id])
  sport           Sport?        @relation(fields: [sportId], references: [id])
  sportCategory   SportCategory? @relation(fields: [sportCategoryId], references: [id])
}
